# ─────────────────────────────────────────────────────────────────────────────
# SMP Analytics — environment variables
#
# Copy to `.env.local` for local development (it's gitignored — never commit it).
# In production these are set as GitHub Actions secrets (ingester) and
# Cloudflare Worker secrets/bindings (API). See docs/deployment.md.
#
# None of these are NEXT_PUBLIC_*: nothing here is ever sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (ingester: read/write) ─────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (IPv4-compatible, required for GitHub Actions). Contains the DB password: SECRET.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# For local development without Supabase, use a file-backed PGlite database:
DATABASE_URL=pglite:.data/dev

# ── WiseHosting SFTP (ingester only) ────────────────────────────────────────
# From the WiseHosting panel's SFTP / file access section. Password: SECRET.
SFTP_HOST=
SFTP_PORT=
SFTP_USERNAME=
SFTP_PASSWORD=
# Folder containing latest.log and the rotated *.log.gz, relative to the SFTP root.
SFTP_LOG_DIR=logs

# ── Time zones ──────────────────────────────────────────────────────────────
# Timezone the Minecraft server writes log timestamps in. WiseHosting: UTC.
SERVER_LOG_TIMEZONE=UTC
# Timezone used to bucket "per day" / "per hour" statistics (the players' timezone).
STATS_TIMEZONE=America/New_York

# ── Local API dev server ────────────────────────────────────────────────────
# Port for `npm run dev:api` (Node + the same DATABASE_URL as above).
API_PORT=8787
