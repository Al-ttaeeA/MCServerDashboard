// Cloudflare Worker configuration. Deployed with `npm run deploy --workspace @smp/api`.
// See docs/deployment.md for the one-time setup (Hyperdrive config id below).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "smp-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // postgres.js needs Node built-ins (net/tls via Cloudflare sockets).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API requests invoke the Worker; static files are served directly (free, not counted).
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Hyperdrive config "smp-db" (not a secret; credentials live in Cloudflare).
      "id": "8ff590797f7a44b1ab490f1ff12891af",
      // Used by `wrangler dev` only; real credentials live in the Hyperdrive config.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  // Every 30 minutes: start the GitHub Actions log sync (GitHub's own cron
  // schedule is unreliable). Requires the GITHUB_DISPATCH_TOKEN secret:
  //   npx wrangler secret put GITHUB_DISPATCH_TOKEN
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": { "GITHUB_REPO": "Al-ttaeeA/MCServerDashboard" },
  "observability": { "enabled": true }
}
